# ========================================================
# ATALICA WEBSITE ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Transactional Email Service (Resend)
# Set this only in your local .env.local or hosting secret manager.
RESEND_API_KEY=

# Recipient for consultation messages.
LEADS_TO_EMAIL=official@atalica.com.pk

# Configure a sender authorized in your Resend account before production use.
LEADS_FROM_EMAIL=onboarding@resend.dev

# Optional Google Analytics 4 measurement ID (for example, G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
